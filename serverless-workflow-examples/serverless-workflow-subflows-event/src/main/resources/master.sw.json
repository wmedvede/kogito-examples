{
  "id": "master",
  "version": "1.0",
  "specVersion": "0.8",
  "name": "master",
  "start": "setup",
  "events": [
    {
      "name": "executeA",
      "source": "",
      "type": "executeA"
    },
    {
      "name": "executeB",
      "source": "",
      "type": "executeB"
    },
    {
      "name": "exitWorkflow",
      "source": "",
      "type": "exitWorkflow"
    }
  ],
  "states": [
    {
      "name": "setup",
      "type": "operation",
      "actions": [
        {
          "name": "setup",
          "subFlowRef": "setup",
          "actionDataFilter": {
            "useResults": true
          }
        }
      ],
      "transition": "waitForEvents"
    },
    {
      "name": "waitForEvents",
      "type": "event",
      "onEvents": [
        {
          "eventRefs": [
            "executeA"
          ],
          "actions": [
            {
              "name": "workflowA",
              "subFlowRef": "workflowA",
              "actionDataFilter": {
                "useResults": true
              }
            }
          ]
        },
        {
          "eventRefs": [
            "executeB"
          ],
          "actions": [
            {
              "name": "workflowB",
              "subFlowRef": "workflowB",
              "actionDataFilter": {
                "useResults": true,
                "results": ".param5",
                "toStateData": ".workflowBData"
              }
            }
          ]
        }
      ],
      "exclusive": false,
      "transition": "waitForExitWorkflow"
    },
    {
      "name": "waitForExitWorkflow",
      "type": "event",
      "onEvents": [
        {
          "eventRefs": [
            "exitWorkflow"
          ]
        }
      ],
      "exclusive": false,
      "end": true
    }
  ]
}