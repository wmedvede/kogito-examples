{
  "id": "exchange_workflow",
  "version": "1.0",
  "name": "Exchange SW example",
  "description": "",
  "start": "Execution1",
  "errors": [
    {
      "name": "execution_error",
      "code": "javax.ws.rs.ProcessingException"
    }
  ],
  "functions": [
    {
      "name": "getEUCentralBankReferenceRates",
      "type": "rest",
      "operation": "specs/eu-central-bank-service.yml#referenceRates"
    },
    {
      "name": "systemOut",
      "type": "custom",
      "operation": "sysout"
    },
    {
      "name": "calculateExchange",
      "type": "custom",
      "operation": "service:org.kie.kogito.examples.CalculateExchangeService::calculateExchange"
    }
  ],
  "states": [
    {
      "name": "Execution1",
      "type": "operation",
      "actions": [
        {
          "name": "executeGetEUCentralBankReferenceRates",
          "functionRef": {
            "refName": "getEUCentralBankReferenceRates",
            "arguments": {
              "date": ".exchangeDate"
            }
          }
        },
        {
          "name": "calculateExchangeAction",
          "functionRef": {
            "refName": "calculateExchange",
            "arguments": {
              "currencyFrom": ".currencyFrom",
              "currencyTo": ".currencyTo",
              "amount": ".amount",
              "rates": ".rates"
            }
          },
          "actionDataFilter": {
            "results": ".value",
            "toStateData": ".exchangeResult"
          }
        }
      ],
      "transition": "EndSuccessful",
      "onErrors": [
        {
          "errorRef": "execution_error",
          "transition": "EndWithError"
        }
      ]
    },
    {
      "name": "EndWithError",
      "type": "inject",
      "data": {
        "executionStatus": "Service execution failed"
      },
      "end": true
    },
    {
      "name": "EndSuccessful",
      "type": "inject",
      "data": {
        "executionStatus": "Service execution successful"
      },
      "end": true
    }
  ]
}